{
  "name": "ai-vehiclesales",
  "version": "0.1.7",
  "private": true,
  "description": "Player used car lot: list owned vehicles for sale, test drives, buyers pay the seller",
  "license": "GPL-3.0-only",
  "author": {
    "name": "TGIANN"
  },
  "repository": "github:aicore8/ai-vehiclesales",
  "type": "module",
  "fxDependencies": [
    "/onesync",
    "ai-core",
    "ai-vehicles"
  ],
  "scripts": {
    "lint": "oxlint --ignore-pattern \"dist/**\"",
    "format": "prettier --write .",
    "dev": "bun tsdown -- --watch",
    "build": "bun run --cwd web build && aicore-db-types && bun tsdown -- && aicore-client-errors dist/client.js",
    "typecheck": "tsc --noEmit -p resource/client/tsconfig.json && tsc --noEmit -p resource/server/tsconfig.json",
    "webdev": "bun run --cwd web dev"
  },
  "dependencies": {
    "@aicore8/lib": "workspace:*",
    "@aicore8/shared": "workspace:*",
    "@aicore8/mysql": "workspace:*"
  },
  "devDependencies": {
    "@aicore8/build": "workspace:*",
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@types/bun": "latest",
    "@types/node": "^22",
    "fast-glob": "^3.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "oxlint": "^1.66.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "fxFiles": [
    "data/settings.json",
    "data/lots.json"
  ]
}
